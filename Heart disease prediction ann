        "import numpy as np\n",
        "import joblib\n",
        "\n",
        "from tensorflow.keras.models import load_model\n",
        "\n",
        "\n",
        "model = load_model(\"heart_ann_model.h5\")\n",
        "scaler = joblib.load(\"heart_scaler.pkl\")\n",
        "\n",
        "print(\"Enter Patient Details\")\n",
        "\n",
        "age = float(input(\"Age: \"))\n",
        "sex = int(input(\"Sex (1=Male, 0=Female): \"))\n",
        "cp = int(input(\"Chest Pain Type (0-3): \"))\n",
        "trestbps = float(input(\"Resting Blood Pressure: \"))\n",
        "chol = float(input(\"Cholesterol: \"))\n",
        "fbs = int(input(\"Fasting Blood Sugar >120 (1=Yes,0=No): \"))\n",
        "restecg = int(input(\"Rest ECG (0-2): \"))\n",
        "thalach = float(input(\"Maximum Heart Rate: \"))\n",
        "exang = int(input(\"Exercise Angina (1=Yes,0=No): \"))\n",
        "oldpeak = float(input(\"Oldpeak: \"))\n",
        "slope = int(input(\"Slope (0-2): \"))\n",
        "ca = int(input(\"Number of Major Vessels (0-4): \"))\n",
        "thal_input = int(input(\"Thal (0=fixed, 1=normal, 2=value '2', 3=reversible): \"))\n",
        "\n",
        "thal_2_oh = 0\n",
        "thal_fixed = 0\n",
        "thal_normal = 0\n",
        "thal_reversible = 0\n",
        "\n",
        "if thal_input == 0:\n",
        "    thal_fixed = 1\n",
        "elif thal_input == 1:\n",
        "    thal_normal = 1\n",
        "elif thal_input == 2:\n",
        "    thal_2_oh = 1\n",
        "elif thal_input == 3:\n",
        "    thal_reversible = 1\n",
        "else:\n",
        "    print(\"Invalid input for Thal. Please enter a value between 0 and 3.\")\n",
        "\n",
        "new_patient = np.array([[age,sex,cp,trestbps,chol,fbs,restecg,thalach,exang,oldpeak,slope,ca,thal_2_oh,thal_fixed,thal_normal,thal_reversible]])\n",
        "\n",
        "new_patient_scaled = scaler.transform(new_patient)\n",
        "\n",
        "prediction_prob = model.predict(new_patient_scaled)[0][0]\n",
        "\n",
        "print(\"\\nPrediction Probability =\", prediction_prob)\n",
        "\n",
        "\n",
        "# Final Result\n",
        "if prediction_prob > 0.5:\n",
        "    print(\"Heart Disease Detected\")\n",
        "else:\n",
        "    print(\"No Heart Disease\")"
